# Cordova plugins for Capacitor
capacitor-cordova-ios-plugins

# App/App/public, capacitor.config.json and config.xml used to be
# regenerated by `cap sync ios` and were ignored here. The native rewrite
# no longer runs `cap sync`, but App.xcodeproj's Resources build phase
# still references those three paths, so committed stub versions replace
# the old auto-generated ones (see App/App/public/.gitkeep,
# App/App/capacitor.config.json, App/App/config.xml).
